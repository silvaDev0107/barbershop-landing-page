---
import ServiceItem from "../components/ServiceItem.astro";
import { Image } from "astro:assets";
import ServiceImage from "../assets/images/man-cuting-hair.jpg"
import Title from "../components/Title.astro";
---

<section class="h-full py-20 px-20 relative">
    <Title>Nuestros Servicios</Title>
    <p class="description text-lg">
        Estos son los servicios que más piden nuestros clientes, si quieres ver el catálogo completo haz click aquí
    </p>
    <div class="container flex mt-6 gap-5 w-full">
        <ul class="list-services mt-5 w-20 flex-2">
            <ServiceItem id="01" name="Corte caballero" price="20.000"/>
            <ServiceItem id="02" name="Corte de barba" price="10.000"/>
            <ServiceItem id="03" name="Corte para niños" price="15.000"/>
            <ServiceItem id="04" name="Cejas" price="9.000"/>
            <ServiceItem id="05" name="Lavado de cabello" price="8.000"/>
        </ul>
        <Image
            src={ServiceImage}
            alt={"man cuting hair"}
            width={600}
            height={400}
            class="flex-end object-cover rounded-md"
        />
    </div>
    <div id="curve" class="bg-primary w-full h-30 absolute left-0 bottom-0"></div>
</section>


<style>
    #curve {
        clip-path: ellipse(70% 100% at 50% 100%);
    }
</style>
